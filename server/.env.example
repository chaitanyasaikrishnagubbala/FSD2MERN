# ==============================================================
# DriveEase Server Environment Variables
# Copy this file to .env and adjust values for your environment
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/driveease?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/driveease

# JWT Authentication Secret & Token Expiration
JWT_SECRET=driveease_jwt_super_secret_development_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
# In local development: http://localhost:5173
# In production: https://your-driveease-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Initial Administrator Credentials (Used by seed script)
# Change these values before deploying to production!
ADMIN_NAME=DriveEase Administrator
ADMIN_EMAIL=admin@driveease.com
ADMIN_PASSWORD=Admin@SecureDrive2026!
ADMIN_PHONE=+91 9876543210
